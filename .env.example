# 数据库
DATABASE_URL="postgresql://user:password@localhost:5432/ai_job_assistant?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/ai_job_assistant?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="15m"

# AI 服务
OPENAI_API_KEY="sk-your-openai-api-key"
DEEPSEEK_API_KEY="sk-your-deepseek-api-key"

# GitHub OAuth（获取：https://github.com/settings/developers）
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"
GITHUB_CALLBACK_URL="http://localhost:3001/api/v1/auth/github/callback"

# 微信开放平台配置（获取：https://open.weixin.qq.com/）
# 注意：需要申请网站应用，不是公众号
WECHAT_APPID="your-wechat-appid"
WECHAT_SECRET="your-wechat-secret"
WECHAT_REDIRECT_URI="http://localhost:3001/api/v1/auth/wechat/callback"

# 腾讯云 OCR（用于图片解析）
# 获取方式：https://console.cloud.tencent.com/cam/capi
TENCENT_SECRET_ID="your-tencent-secret-id"
TENCENT_SECRET_KEY="your-tencent-secret-key"

# SMTP 邮件配置（可选，不配置则邮件仅记录到日志）
# SMTP_HOST="smtp.example.com"
# SMTP_PORT=465
# SMTP_USER="your-email@example.com"
# SMTP_PASS="your-smtp-password"
# SMTP_FROM="noreply@example.com"

# 应用配置
NODE_ENV="development"
PORT=3001
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"

# 前端
NEXT_PUBLIC_API_URL="http://localhost:3001/api/v1"

# 支付宝沙箱配置（获取：https://open.alipay.com/develop/sandbox/app）
ALIPAY_SANDBOX_APP_ID="沙箱应用ID"
ALIPAY_SANDBOX_PRIVATE_KEY="应用私钥（RSA2）"
ALIPAY_SANDBOX_PUBLIC_KEY="支付宝公钥"

# 应用 URL
WEB_URL="http://localhost:3000"
API_URL="http://localhost:3001/api/v1"
